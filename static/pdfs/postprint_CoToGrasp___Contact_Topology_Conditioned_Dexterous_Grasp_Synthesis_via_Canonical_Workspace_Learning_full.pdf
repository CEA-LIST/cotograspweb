dup 52 /four put
dup 57 /nine put
dup 49 /one put
dup 37 /percent put
dup 43 /plus put
dup 54 /six put
dup 51 /three put
dup 126 /tilde put
dup 50 /two put
dup 48 /zero put
readonly def
currentdict end
